{
  "version": 2,
  "outputDirectory": ".",
  "installCommand": "npm install --omit=dev",
  "framework": null,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...slug].js" },
    { "handle": "filesystem" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/admin/", "dest": "/admin/index.html" }
  ]
}
